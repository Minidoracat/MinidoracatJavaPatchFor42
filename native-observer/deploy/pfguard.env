# MDC_PFGUARD_* tuning read by run-with-pfguard.sh (root:pzserver 0640 on the server; only
# `MDC_PFGUARD_<NAME>=<[A-Za-z0-9_,]*>` lines are accepted, never sourced).
# Round 3 (2026-09-07): the shim (layout v5) now returns the cluster absorbed by
# VehicleCluster::merge to its pool (MDC_PFGUARD_MERGE_RELEASE=0 turns that off), so the
# victim class — VehicleCluster rect arrays grown by createVehicleCluster and by merge —
# no longer leaks ~40 blocks/s and can be guarded without saturating the live-block cap.
# Both cores (8/31, 9/7) show the wild write landing at user-8/user+0 of exactly such an
# array; with the array on a guard page the writer's own instruction faults.
# createVehicleClusters (the per-round list) is deliberately not listed. The round-2 A*
# callers stay as bounded diagnostics. See docs/pathfind-aligned-block-guard-design-v1.md §9.
MDC_PFGUARD_CALLERS=_ZN13PolygonalMap220createVehicleClusterEP11VehicleRectR9ArrayListIS1_ERS2_IP14VehicleClusterE,_ZN14VehicleCluster5mergeEPS_,_ZN7HLAStar8findPathEP15PathFindRequestR9ArrayListIP12HLChunkLevelERS2_IP17HLLevelTransitionERS2_IbE,_ZN7HLAStar30addChunkLevelAndAdjacentToListEP12HLChunkLevelR9ArrayListIS1_E,_ZN7HLAStar30addChunkLevelAndAdjacentToListEP13HLChunkRegionR9ArrayListIP12HLChunkLevelE,_ZN7HLAStar22setLowestCostSuccessorEP12HLSearchNodeS1_d,_ZN7HLAStar13getSuccessorsEP12HLSearchNodeR9ArrayListIP11ISearchNodeE,_ZN7HLAStar12addSuccessorEdP12HLSearchNodeP13HLChunkRegionR9ArrayListIP11ISearchNodeE,_ZN7HLAStar12addSuccessorEdP12HLSearchNodeP17HLLevelTransitionbR9ArrayListIP11ISearchNodeE,_ZN7HLAStar12addSuccessorEdP12HLSearchNodeP4NodeR9ArrayListIP11ISearchNodeE,_ZN12HLChunkLevel10initStairsEv,_ZN12HLChunkLevel11initRegionsEv,_ZN12HLChunkLevel18initSlopedSurfacesEv,_ZN10SearchNode13getSuccessorsER9ArrayListIP11ISearchNodeE,_ZN7VGAStar13getSearchNodeEP4Node,_ZN7VGAStar13getSearchNodeEP6Square,_ZN7VGAStar13getSearchNodeEii,_ZN13PolygonalMap229findPathHighLevelThenLowLevelEP15PathFindRequestb
MDC_PFGUARD_MAXBLOCKS=65536
MDC_PFGUARD_QUARANTINE=16384
MDC_PFGUARD_MERGE_RELEASE=1
