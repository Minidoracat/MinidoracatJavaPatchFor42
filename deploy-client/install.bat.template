@echo off
setlocal EnableExtensions
set "SRC=%~dp0"
set "EXPECTED_JAR=__JAR_SHA__"

rem 全檔線性 goto 流程、零括號區塊：路徑含 ( ) 時 cmd 的括號區塊會誤解析（實測）

if exist "%SRC%patch-files\zombie\core\textures\TextureIDAssetManager.class" goto :havepayload
echo [ERROR] patch-files folder is missing. Re-extract the whole zip first.
goto :fail
:havepayload

rem 來源完整性預檢：zip 損壞/解壓不完整在碰遊戲目錄之前就擋下（逐檔生成於建置時）
__SRC_CHECKS__

rem --- locate game folder: same-dir, PZ_GAMEDIR override, then Steam registry + library list ---
set "GAMEDIR="
if exist "%SRC%ProjectZomboid64.exe" set "GAMEDIR=%SRC%"
if defined GAMEDIR goto :located
if not defined PZ_GAMEDIR goto :steamlookup
if exist "%PZ_GAMEDIR%\ProjectZomboid64.exe" set "GAMEDIR=%PZ_GAMEDIR%"
if defined GAMEDIR goto :located
:steamlookup
echo Locating Project Zomboid via Steam...
for /f "delims=" %%G in ('powershell -NoProfile -ExecutionPolicy Bypass -Command "$s=(Get-ItemProperty 'HKCU:\Software\Valve\Steam' -ErrorAction SilentlyContinue).SteamPath; if($s){ $roots=@($s); $v=Join-Path $s 'steamapps/libraryfolders.vdf'; if(Test-Path $v){ $m=(Select-String -Path $v -Pattern '\x22path\x22\s+\x22([^\x22]+)\x22' -AllMatches).Matches; foreach($x in $m){ $roots+=$x.Groups[1].Value.Replace('\\','\') } }; foreach($r in $roots){ $g=Join-Path $r 'steamapps/common/ProjectZomboid'; if(Test-Path (Join-Path $g 'ProjectZomboid64.exe')){ (Get-Item $g).FullName; break } } }"') do set "GAMEDIR=%%G"
if defined GAMEDIR goto :located
echo [ERROR] Could not find the Project Zomboid game folder automatically.
echo         Extract this zip into the game folder itself and run install.bat again.
echo         Game folder: Steam - Project Zomboid - Manage - Browse local files
goto :fail
:located
if not "%GAMEDIR:~-1%"=="\" set "GAMEDIR=%GAMEDIR%\"
if exist "%GAMEDIR%ProjectZomboid64.exe" goto :gamedirok
echo [ERROR] "%GAMEDIR%" does not look like the game folder.
goto :fail
:gamedirok
echo Game folder: "%GAMEDIR%"

echo Checking game version...
call :hash "%GAMEDIR%projectzomboid.jar"
if /i "%HASH%"=="%EXPECTED_JAR%" goto :versionok
echo [ERROR] Game version mismatch - this patch is for build __GAME_VERSION__ only.
echo    expected %EXPECTED_JAR%
echo    actual   %HASH%
goto :fail
:versionok

rem 衝突閘：逐 payload 檔生成於建置時（存在且指紋不同=其他 patch 佔用，拒裝）
__CONFLICT_CHECKS__

echo Installing...
xcopy /y /e /i /q "%SRC%patch-files\zombie" "%GAMEDIR%zombie" >nul
if errorlevel 1 goto :copyfail

rem 複製後回驗：逐 payload 檔生成於建置時
__VERIFY_CHECKS__

echo [OK] Patch installed and verified. Start the game normally.
echo      To confirm in-game: search "TexPipelineGuard" in %%UserProfile%%\Zomboid\console.txt
pause
exit /b 0

:copyfail
echo [ERROR] Copy failed.
goto :fail

:verifyfail
echo [ERROR] Post-install verification failed - rolling back this install...
rem 回滾：衝突閘已保證安裝前目標位置為空或與本 payload 完全相同,直接刪除本次寫入即還原
__ROLLBACK_DELETES__
rd "%GAMEDIR%zombie\core\textures" 2>nul
rd "%GAMEDIR%zombie\core" 2>nul
rd "%GAMEDIR%zombie\mdc" 2>nul
rd "%GAMEDIR%zombie" 2>nul
echo [ERROR] Rolled back. Re-extract the zip and try again.
goto :fail

:hash
set "HASH="
for /f "delims=" %%H in ('certutil -hashfile "%~1" SHA256 ^| find /v ":"') do set "HASH=%%H"
set "HASH=%HASH: =%"
exit /b 0

:fail
pause
exit /b 1
